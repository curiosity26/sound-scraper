---
import {
  googleTagEnabled as enabled,
  googleTagId as id,
} from '@/lib/google-tag'
---

{enabled && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${id}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    />
  </noscript>
)}

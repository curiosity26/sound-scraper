---
import {
  googleTagEnabled as enabled,
  googleTagId as id,
} from '@/lib/google-tag'
---

{enabled && (
  <>
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtm.js?id=${id}`}
    />
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
    </script>
  </>
)}

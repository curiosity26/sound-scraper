# LF everywhere, whatever core.autocrlf says, so Prettier's lint passes on
# Windows checkouts too.
* text=auto eol=lf
# Visual Studio expects CRLF in its project files.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.wapproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.appxmanifest text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.ico binary

{
  "name": "SoundScraper",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "windows": "npx @react-native-community/cli run-windows",
    "core:build": "cargo build --manifest-path ../core/Cargo.toml",
    "core:test": "cargo test --manifest-path ../core/Cargo.toml",
    "codegen:windows": "react-native codegen-windows",
    "lint": "eslint .",
    "test": "jest",
    "test:windows": "jest --config jest.config.windows.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-windows": "0.83.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-windows/find-dotnet-tools": "0.84.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "@rnx-kit/jest-preset": "^0.3.1"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "SoundScraper",
      "namespace": "SoundScraper",
      "template": "cpp-app"
    }
  },
  "codegenConfig": {
    "name": "SoundScraperSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "ios": {
      "modulesProvider": {
        "SoundScraper": "RCTSoundScraper"
      }
    },
    "windows": {
      "namespace": "SoundScraperCodegen",
      "outputDirectory": "windows/SoundScraper/codegen",
      "separateDataTypes": true
    }
  }
}

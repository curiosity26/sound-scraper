{
  "name": "SoundScraper",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "macos": "react-native run-macos",
    "windows": "npx @react-native-community/cli run-windows",
    "core:build": "cargo build --manifest-path ../core/Cargo.toml",
    "core:test": "cargo test --manifest-path ../core/Cargo.toml",
    "bridge:types": "node scripts/gen-bridge-types.js",
    "codegen:windows": "react-native codegen-windows",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "test": "vitest run",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "linux": "react-native run-linux"
  },
  "dependencies": {
    "core-js": "3.51.0",
    "react": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-windows": "0.83.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.29.13",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native-windows/find-dotnet-tools": "0.84.1",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-plugin": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sound-scraper": "file:eslint-rules",
    "globals": "^17.14.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "test-renderer": "~1.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@curiosity26/react-native-gtk4": "0.83.6"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-parser": "^5.7.0",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-native": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "SoundScraper",
      "namespace": "SoundScraper",
      "template": "cpp-app"
    }
  },
  "codegenConfig": {
    "name": "SoundScraperSpec",
    "type": "modules",
    "jsSrcsDir": "src/bridge",
    "ios": {
      "modulesProvider": {
        "SoundScraper": "RCTSoundScraper",
        "SoundScraperSkins": "RCTSoundScraperSkins",
        "SoundScraperEditor": "RCTSoundScraperEditor"
      }
    },
    "windows": {
      "namespace": "SoundScraperCodegen",
      "outputDirectory": "windows/SoundScraper/codegen",
      "separateDataTypes": true
    }
  }
}

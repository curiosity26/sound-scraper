+#if TARGET_OS_OSX // [macOS
+// An NSTextField being edited isn't the first responder itself: its field
+// editor (an NSTextView) is.
+- (BOOL)_isEditing
+{
+  if ([_backedTextInputView isKindOfClass:[NSTextField class]]) {
+    return [(NSTextField *)_backedTextInputView currentEditor] != nil;
+  }
+  NSResponder *responder = [_backedTextInputView respondsToSelector:@selector(responder)]
+      ? _backedTextInputView.responder
+      : (NSResponder *)_backedTextInputView;
+  return [[_backedTextInputView window] firstResponder] == responder;
+}
+#endif // macOS]
+
+- (void)_selectAllText
+{
+#if TARGET_OS_OSX // [macOS
+  // NSTextField has no selectAll:; its field editor does.
+  if ([_backedTextInputView isKindOfClass:[NSTextField class]]) {
+    [[(NSTextField *)_backedTextInputView currentEditor] selectAll:nil];
+  } else {
+    [_backedTextInputView selectAll:nil];
+  }
+#else // [macOS]
+  [_backedTextInputView selectAll:nil];
+#endif // macOS]
+  [self textInputDidChangeSelection];
+}
